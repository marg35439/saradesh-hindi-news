{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/ads.txt",
      "destination": "/api"
    },
    {
      "source": "/rss.xml",
      "destination": "/api"
    },
    {
      "source": "/feed.xml",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|sitemap|news-sitemap|robots|ads|rss|feed).*)",
      "destination": "/index.html"
    }
  ]
}
