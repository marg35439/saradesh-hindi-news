{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/rss.xml",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|sitemap|robots|rss).*)",
      "destination": "/index.html"
    }
  ]
}
