rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Articles collection
    match /articles/{articleId} {
      // Anyone can read news articles
      allow read: if true;
      
      // Only authenticated admins can create or delete articles
      allow create, delete: if request.auth != null;
      
      // Updates allowed for authenticated admins, OR for public readers adding likes/comments/views
      allow update: if request.auth != null 
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'views']);
    }

    // Deleted articles index
    match /deleted_articles/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
